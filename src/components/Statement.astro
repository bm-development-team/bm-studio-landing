---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CaseMedia from './CaseMedia.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.statement;
const firstCase = t.cases.items[0];
---

<!-- Statement: a big line crossed by a blue ribbon that draws itself as you scroll,
     a small window onto real work, and one paragraph with a quiet action. -->
<section class="relative overflow-hidden px-4 py-20 md:px-8 md:py-32" data-statement>
  <svg
    class="ribbon pointer-events-none absolute hidden md:block text-blue md:-left-[4%] md:top-0 md:h-[85%] md:w-[60%]"
    viewBox="0 0 800 600"
    fill="none"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M-20 40 C 180 60, 420 120, 470 260 C 520 400, 380 470, 300 420 C 220 370, 300 250, 470 250 C 640 250, 720 420, 820 590"
      pathLength="1"
      stroke="currentColor"
      stroke-width="26"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <div class="relative mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-12 lg:gap-x-8">
    <h2 data-reveal class="t-display text-ink lg:col-span-10 lg:col-start-3">
      {s.lines[0]}<br />{s.lines[1]}
    </h2>

    <a href="#cases" data-reveal class="card group relative block aspect-[4/3] w-full max-w-[520px] overflow-hidden lg:col-span-4 lg:row-start-2 lg:self-end">
      <CaseMedia item={firstCase} compact />
      <span class="t-micro absolute bottom-3 left-[5%] rounded-full bg-white px-3 py-1.5 text-ink">{firstCase.title} ↗</span>
    </a>

    <div data-reveal style="--reveal-delay: 120ms" class="flex flex-col items-start gap-8 lg:col-span-4 lg:col-start-8 lg:row-start-2 lg:self-end">
      <p class="t-body max-w-[40ch] text-ink/80">{s.text}</p>
      <a href="#process" class="pill bg-white text-ink hover:bg-ink hover:text-white">
        <span class="pill-dot" aria-hidden="true"></span> {s.cta}
      </a>
    </div>
  </div>
</section>

<script>
  // draw the ribbon with the section's progress through the viewport
  const section = document.querySelector<HTMLElement>('[data-statement]');
  const ribbon = section?.querySelector<SVGSVGElement>('.ribbon');
  if (section && ribbon && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = section.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height * 0.4)));
      ribbon.style.setProperty('--draw', String(1 - p));
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
