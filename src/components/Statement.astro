---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.statement;
---

<!-- Statement: a big line, the headline offer as an orange card, and one paragraph with a quiet action. -->
<section class="relative overflow-hidden px-3 py-20 md:px-8 md:py-32" data-statement>

  <div class="relative mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-12 lg:gap-x-8">
    <h2 data-split class="t-display text-ink lg:col-span-10 lg:col-start-3">
      {s.lines[0]}<br />{s.lines[1]}
    </h2>

    <div class="lg:col-span-4 lg:row-start-2 lg:self-end">
      <a href="#process" data-reveal class="card group relative flex aspect-[4/3] w-full max-w-[520px] flex-col justify-between overflow-hidden bg-accent p-6 text-white md:p-8">
        <span class="pointer-events-none absolute -right-16 -top-20 aspect-square w-[70%] rounded-full bg-accent-soft/40 transition-transform duration-700 group-hover:scale-110" aria-hidden="true"></span>
        <span class="t-micro relative text-white/75">{s.stat.label}</span>
        <span class="relative flex items-end justify-between gap-4">
          <span class="whitespace-nowrap text-[clamp(3.75rem,2rem+4.2vw,6.5rem)] font-medium leading-[0.8] tracking-[-0.06em]">{s.stat.value}</span>
          <span class="max-w-[14ch] pb-1 text-right text-[clamp(1rem,0.85rem+0.4vw,1.25rem)] font-medium leading-[1.1] tracking-[-0.02em]">{s.stat.text}</span>
        </span>
      </a>
    </div>

    <div data-reveal style="--reveal-delay: 120ms" class="flex flex-col items-start gap-8 lg:col-span-4 lg:col-start-8 lg:row-start-2 lg:self-end">
      <p class="t-body max-w-[40ch] text-ink/80">{s.text}</p>
      <a href="#process" class="pill bg-white text-ink hover:bg-ink hover:text-white">
        <span class="pill-dot" aria-hidden="true"></span> {s.cta}
      </a>
    </div>
  </div>
</section>

