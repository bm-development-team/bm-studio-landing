---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const socials: { label: string; href: string }[] = [
  { label: 'telegram', href: '#' },
  { label: 'whatsapp', href: '#' },
  { label: 'instagram', href: '#' },
];
const tel = t.contact.phone.replace(/[^+\d]/g, '');
// "+7 (777) 726 26 20" → "+7 777 726 26 20": shorter, so it can be set larger on one line
const phoneDisplay = t.contact.phone.replace(/[()]/g, '');
const year = new Date().getFullYear();
---

<!-- Footer: the way to get in touch is the headline. -->
<footer class="bg-blue text-white">
  <div class="mx-auto flex min-h-[64svh] max-w-[1440px] flex-col px-5 py-8 md:px-8 lg:min-h-[90svh] lg:py-10">
    <div class="flex items-start justify-between gap-6">
      <div class="flex flex-col gap-1 t-small font-medium md:flex-row md:gap-10">
        <a href="/" class="flex items-center gap-2 font-extrabold" aria-label="BM Studio">
          <img src="/assets/icons/logo.svg" alt="" width="32" height="15" class="-rotate-12 brightness-0 invert" aria-hidden="true" />
          BM Studio
        </a>
        {t.footer.notes.map((n) => <p class="text-white/85">{n}</p>)}
      </div>
      <a href="#top" class="t-small shrink-0 font-semibold hover:underline">{t.footer.top} ↑</a>
    </div>

    <div class="mt-auto pt-24">
      <a
        href={`tel:${tel}`}
        class="block whitespace-nowrap font-extrabold leading-[0.95] tracking-[-0.045em] transition-colors hover:text-red"
        style="font-size: clamp(2rem, 9.4vw, 9rem)"
      >
        {phoneDisplay}
      </a>
      <a href={`mailto:${t.contact.email}`} class="t-lead mt-4 block w-fit font-bold hover:underline">{t.contact.email}</a>

      <div class="mt-12 flex flex-col gap-4 t-small font-medium md:flex-row md:items-center md:justify-between">
        <div class="flex flex-wrap gap-5">
          {socials.map((s) => (
            <a href={s.href} class="flex items-center gap-2 hover:underline" aria-label={s.label}>
              <img src={`/assets/icons/${s.label}.svg`} alt="" width="18" height="18" class="size-[18px] brightness-0 invert" aria-hidden="true" />
              {s.label}
            </a>
          ))}
        </div>
        <nav class="flex gap-5" aria-label="Footer">
          <a href="#services" class="hover:underline">{t.nav.services}</a>
          <a href="#cases" class="hover:underline">{t.nav.cases}</a>
          <a href="#process" class="hover:underline">{t.nav.process}</a>
        </nav>
        <p class="text-white/85">© {year} BM Studio</p>
      </div>
    </div>
  </div>
</footer>
