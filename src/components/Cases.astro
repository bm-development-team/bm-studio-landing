---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// band ground / ink and a contrasting tab colour, per project
const looks = [
  { band: 'bg-blue text-white', tab: 'bg-red text-ink' },
  { band: 'bg-black text-white', tab: 'bg-blue text-white' },
];
---

<!-- Work filed as folders: a tab with the name, a flat band holding the real work.
     Phone: bands stack in normal flow. Desktop: bands stick and pile up as you scroll. -->
<section id="cases" class="scroll-mt-16 bg-white pt-16 md:scroll-mt-20 md:pt-24 lg:pt-32">
  <div class="mx-auto max-w-[1440px] px-5 md:px-8">
    <h2 data-reveal class="t-head text-ink">{t.cases.heading}</h2>
  </div>

  <div class="mt-10 lg:mt-14">
    {t.cases.items.map((item, i) => {
      const look = looks[i % looks.length];
      return (
        <article
          class="lg:sticky"
          style={`--stack: ${i}`}
          data-case
        >
          <div class="mx-auto flex max-w-[1440px] items-end gap-1.5 px-5 md:px-8">
            <h3 class:list={['folder-tab flex h-11 min-w-[180px] items-center pl-4 pr-10 text-[20px] font-extrabold tracking-[-0.02em] md:min-w-[260px] md:text-[26px]', look.tab]}>
              {item.title}
            </h3>
          </div>
          <div class:list={['lg:min-h-[78svh]', look.band]}>
            <div class="mx-auto grid max-w-[1440px] gap-8 px-5 pb-12 pt-5 md:px-8 lg:grid-cols-12 lg:gap-x-8 lg:pb-16">
              <p class="t-small font-semibold opacity-80 lg:col-span-12 lg:text-right">{item.category}</p>

              <figure class="relative lg:col-span-7" data-reveal>
                <div class="aspect-[4/3] overflow-hidden bg-paper lg:aspect-[16/10]">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    width="1440"
                    height="900"
                    class:list={['drift size-full', item.imageMobile ? 'object-cover object-left-top' : 'object-contain p-4']}
                  />
                </div>
                {item.imageMobile && (
                  <img
                    src={item.imageMobile}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    width="390"
                    height="844"
                    class="absolute -bottom-6 right-3 w-[30%] max-w-[170px] rotate-[4deg] border-[5px] border-ink bg-white"
                  />
                )}
              </figure>

              <div class="flex flex-col gap-6 lg:col-span-4 lg:col-start-9" data-reveal style="--reveal-delay: 90ms">
                <p class="t-lead font-medium">{item.text}</p>
                {item.url && (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener"
                    class:list={['press flex h-14 w-full items-center justify-center gap-2 t-body font-semibold sm:w-fit sm:px-7', look.tab]}
                  >
                    {t.cases.visit} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    [data-case] {
      top: calc(80px + var(--stack) * 56px);
    }
  }
</style>
