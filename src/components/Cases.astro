---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CaseMedia from './CaseMedia.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Work: a two-column grid of rounded, framed previews; tags above the name, one sentence below.
     On desktop a round "view" cursor follows the pointer over the pictures. -->
<section id="cases" class="scroll-mt-20 px-3 pb-20 md:px-8 md:pb-32">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid gap-5 px-1 lg:grid-cols-12 lg:items-end lg:gap-x-8">
      <h2 data-reveal class="t-head text-ink lg:col-span-7">{t.cases.heading}</h2>
      <p data-reveal style="--reveal-delay: 90ms" class="t-micro max-w-[34ch] text-ink/60 lg:col-span-3 lg:col-start-10 lg:pb-3 lg:text-right">{t.cases.lead}</p>
    </div>

    <div class="mt-10 grid gap-x-3 gap-y-12 md:mt-14 md:grid-cols-2">
      {t.cases.items.map((item, i) => {
        const Tag = item.url ? 'a' : 'div';
        const linkProps = item.url ? { href: item.url, target: '_blank', rel: 'noopener' } : {};
        return (
          <article data-case data-reveal style={`--reveal-delay: ${(i % 2) * 110}ms`} class="work-card group">
            <Tag {...linkProps} data-view class="card block aspect-[4/3] overflow-hidden" tabindex={item.url ? -1 : undefined}>
              <CaseMedia item={item} />
            </Tag>
            <div class="mt-5 flex flex-wrap items-center gap-2 px-1">
              {item.category.split(' · ').map((tag) => (
                <span class="t-micro rounded-full bg-white px-3 py-1.5 text-ink/70">{tag}</span>
              ))}
            </div>
            <div class="mt-3 flex items-start justify-between gap-4 px-1">
              <h3 class="text-[clamp(1.75rem,1.2rem+1.4vw,2.75rem)] font-medium leading-none tracking-[-0.04em] text-ink">{item.title}</h3>
              {item.url && (
                <a href={item.url} target="_blank" rel="noopener" class="pill shrink-0 bg-ink text-white hover:bg-blue">
                  {t.cases.visit} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
            <p class="t-body mt-3 max-w-[52ch] px-1 text-ink/65">{item.text}</p>
          </article>
        );
      })}
    </div>
  </div>
  <span class="view-cursor" data-view-cursor aria-hidden="true">{t.cases.view}</span>
</section>

<script>
  const cursor = document.querySelector<HTMLElement>('[data-view-cursor]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (cursor && fine) {
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((el) => {
      el.style.cursor = 'none';
      el.addEventListener('pointerenter', () => cursor.classList.add('is-on'));
      el.addEventListener('pointerleave', () => cursor.classList.remove('is-on'));
    });
    window.addEventListener(
      'pointermove',
      (e) => {
        cursor.style.setProperty('--x', `${e.clientX}px`);
        cursor.style.setProperty('--y', `${e.clientY}px`);
      },
      { passive: true },
    );
  }
</script>
