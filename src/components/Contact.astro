---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { estimates } from '../data/estimates';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;

// option = filled block in a lighter tone of the coupon; pressed = solid ink
const optBase =
  'group flex w-full items-center justify-between gap-3 bg-red-soft px-4 py-4 text-left text-ink transition-colors duration-200 hover:bg-[#ff9378] aria-pressed:bg-ink aria-pressed:text-white';
const radioDot =
  'grid size-5 shrink-0 place-items-center rounded-full border-2 border-ink/50 transition group-aria-pressed:border-white group-aria-pressed:bg-white';
const check =
  '<svg class="size-2.5 scale-0 text-ink transition-transform group-aria-pressed:scale-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
const inputClass =
  'mt-2 h-14 w-full bg-red-soft px-4 t-body text-ink placeholder:text-ink/55 focus:bg-white focus:outline-none focus-visible:outline-2 focus-visible:outline-ink';
const qTitle = 't-lead font-extrabold tracking-[-0.02em]';
const qSub = 't-small mt-1 font-medium text-ink/70';
---

<!-- Contact: the brief is a coupon to tear off. Phone: upright card, horizontal perforation.
     Desktop: wide card, vertical perforation at ~42%. -->
<section id="contact" class="scroll-mt-16 bg-white px-3 py-16 md:scroll-mt-20 md:px-8 md:py-24 lg:py-32">
  <form
    data-brief
    data-reveal
    method="POST"
    action="https://formspree.io/f/YOUR_FORM_ID"
    class="mx-auto flex max-w-[1376px] flex-col overflow-hidden bg-red text-ink lg:grid lg:grid-cols-[minmax(0,42fr)_32px_minmax(0,58fr)]"
  >
    <!-- LEFT: heading, sentence, progress list, live estimate, direct contacts -->
    <div class="flex flex-col gap-8 p-6 md:p-10 lg:p-12">
      <div>
        <h2 class="t-head max-w-[9ch]">{c.heading}</h2>
        <p class="t-body mt-5 max-w-[34ch] font-medium">{c.description}</p>
      </div>

      <ol class="hidden flex-col gap-2.5 md:flex" data-nav>
        {c.stepNav.map((label, i) => (
          <li class="flex items-center gap-3" data-nav-item>
            <span data-nav-circle class:list={['grid size-6 shrink-0 place-items-center rounded-full t-small font-bold', i === 0 ? 'bg-ink text-white' : 'border-2 border-ink/35 text-ink/60']}>{i + 1}</span>
            <span data-nav-label class:list={['t-body', i === 0 ? 'font-bold' : 'font-medium text-ink/60']}>{label}</span>
          </li>
        ))}
      </ol>

      <!-- live estimate (appears once a project type is chosen) -->
      <div data-estimate hidden class="bg-ink p-5 text-white">
        <p class="flex items-center gap-2 t-small font-semibold text-white/70">
          <span class="estimate-pulse size-2 rounded-full bg-red" aria-hidden="true"></span>
          {c.estimate.label}
        </p>
        <p class="t-head mt-3" data-estimate-weeks aria-live="polite"></p>
        <p class="t-body mt-2 text-white/80" data-estimate-budget></p>
        <div class="mt-4 h-1.5 bg-white/15">
          <span data-estimate-bar class="block h-full bg-red transition-[width] duration-700 ease-out" style="width: 0%"></span>
        </div>
        <p class="t-small mt-3 text-white/60">{c.estimate.note}</p>
      </div>

      <div class="mt-auto flex flex-col gap-1 t-body font-semibold">
        <a href={`tel:${c.phone.replace(/[^+\d]/g, '')}`} class="w-fit hover:underline">{c.phone}</a>
        <a href={`mailto:${c.email}`} class="w-fit hover:underline">{c.email}</a>
      </div>
    </div>

    <!-- perforation -->
    <div class="perf perf-h perf-v flex items-center justify-center" aria-hidden="true">
      <span class="perf-dots-h perf-dots-v block w-[calc(100%-40px)] lg:h-[calc(100%-40px)] lg:w-auto"></span>
    </div>

    <!-- RIGHT: the wizard -->
    <div class="flex flex-col p-6 md:p-10 lg:p-12">
      <div class="flex items-center justify-between gap-4">
        <span class="t-small font-semibold">
          {c.stepWord} <span data-step-num>1</span> {c.ofWord} 5
        </span>
        <div class="flex w-40 gap-1" data-dots role="presentation">
          {Array.from({ length: 5 }).map((_, i) => (
            <span data-dot data-state={i === 0 ? 'active' : 'todo'} class="h-2 flex-1 bg-ink/20 transition-colors data-[state=active]:bg-ink data-[state=done]:bg-ink/60"></span>
          ))}
        </div>
      </div>

      <div class="mt-8 flex-1">
        <!-- STEP 1: direction -->
        <div data-step data-key="direction" data-num="0">
          <h3 class={qTitle}>{c.q1.title}</h3>
          <p class={qSub}>{c.q1.sub}</p>
          <div class="mt-5 grid gap-2 sm:grid-cols-2">
            {c.q1.options.map((o) => (
              <button type="button" data-opt data-value={o.value} data-label={o.label} aria-pressed="false" class={optBase}>
                <span class="flex flex-col">
                  <span class="t-body font-bold">{o.label}</span>
                  {o.sub && <span class="t-small opacity-75">{o.sub}</span>}
                </span>
                <span class={radioDot} set:html={check} />
              </button>
            ))}
          </div>
        </div>

        <!-- STEP 2: project type (branches by direction) -->
        <div data-step data-key="projectType" data-num="1" class="hidden">
          <h3 class={qTitle}>{c.q2.title}</h3>
          <p class={qSub}>{c.q2.sub}</p>
          {Object.entries(c.q2.byDirection).map(([dir, opts]) => (
            <div data-type-group data-dir={dir} class="mt-5 hidden grid-cols-1 gap-2 sm:grid-cols-2">
              {opts.map((o, idx) => (
                <button type="button" data-opt data-idx={idx} data-value={o.value} data-label={o.label} aria-pressed="false" class={optBase}>
                  <span class="flex flex-col">
                    <span class="t-body font-bold">{o.label}</span>
                    {o.sub && <span class="t-small opacity-75">{o.sub}</span>}
                  </span>
                  <span class={radioDot} set:html={check} />
                </button>
              ))}
            </div>
          ))}
        </div>

        <!-- STEP 3: budget -->
        <div data-step data-key="budget" data-num="2" class="hidden">
          <h3 class={qTitle}>{c.q3.title}</h3>
          <p class={qSub}>{c.q3.sub}</p>
          <div class="mt-5 flex flex-col gap-2">
            {c.q3.options.map((o, tier) => (
              <button type="button" data-opt data-tier={tier} data-value={o.value} data-label={o.label} aria-pressed="false" class={optBase}>
                <span class="flex flex-col">
                  <span class="t-body font-bold">{o.label}</span>
                  {o.sub && <span class="t-small opacity-75">{o.sub}</span>}
                </span>
                <span class={radioDot} set:html={check} />
              </button>
            ))}
          </div>
          <p data-budget-hint hidden class="estimate-in t-small mt-4 bg-ink px-4 py-3 font-medium text-white"></p>
        </div>

        <!-- STEP 4: timeline -->
        <div data-step data-key="timeline" data-num="3" class="hidden">
          <h3 class={qTitle}>{c.q4.title}</h3>
          <p class={qSub}>{c.q4.sub}</p>
          <div class="mt-5 flex flex-col gap-2">
            {c.q4.options.map((o) => (
              <button type="button" data-opt data-value={o.value} data-label={o.label} aria-pressed="false" class={optBase}>
                <span class="t-body font-bold">{o.label}</span>
                <span class={radioDot} set:html={check} />
              </button>
            ))}
          </div>
        </div>

        <!-- STEP 5: contacts -->
        <div data-step data-key="contacts" data-num="4" class="hidden">
          <h3 class={qTitle}>{c.q5.title}</h3>
          <p class={qSub}>{c.q5.sub}</p>
          <div data-chips class="mt-4 flex flex-wrap gap-2"></div>
          <div class="mt-5 space-y-3">
            <label class="block">
              <span class="t-small font-semibold">{c.q5.nameLabel}</span>
              <input type="text" name="name" required autocomplete="name" data-field placeholder={c.q5.namePlaceholder} class={inputClass} />
            </label>
            <label class="block">
              <span class="t-small font-semibold">{c.q5.contactLabel}</span>
              <input type="text" name="contact" required autocomplete="email" data-field placeholder={c.q5.contactPlaceholder} class={inputClass} />
            </label>
          </div>
        </div>
      </div>

      <!-- hidden inputs for submission -->
      <input type="hidden" name="direction" data-in="direction" />
      <input type="hidden" name="project_type" data-in="projectType" />
      <input type="hidden" name="budget" data-in="budget" />
      <input type="hidden" name="timeline" data-in="timeline" />

      <div class="mt-8 flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <button type="button" data-back class="invisible flex h-14 items-center justify-center gap-2 px-5 t-body font-semibold hover:underline">
          <span aria-hidden="true">←</span> {c.back}
        </button>
        <button type="button" data-action class="press group/btn flex h-14 flex-1 items-center justify-center gap-2 bg-ink px-7 t-body font-bold text-white hover:bg-[#222] disabled:cursor-not-allowed disabled:bg-ink/35 disabled:hover:translate-y-0">
          <span data-action-label>{c.next}</span>
          <span data-action-arrow class="transition-transform duration-300 group-hover/btn:translate-x-1" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </form>
</section>

<script is:inline define:vars={{ nextLabel: c.next, submitLabel: c.submit, estimates, est: c.estimate, lang, budgetLabels: c.q3.options.map((o) => o.label) }}>
  document.querySelectorAll('[data-brief]').forEach((form) => {
    const steps = [...form.querySelectorAll('[data-step]')];
    const total = steps.length;
    const navItems = [...form.querySelectorAll('[data-nav-item]')];
    const dots = [...form.querySelectorAll('[data-dot]')];
    const stepNum = form.querySelector('[data-step-num]');
    const backBtn = form.querySelector('[data-back]');
    const actionBtn = form.querySelector('[data-action]');
    const actionLabel = form.querySelector('[data-action-label]');
    const actionArrow = form.querySelector('[data-action-arrow]');
    const chipsBox = form.querySelector('[data-chips]');
    const hidden = {
      direction: form.querySelector('[data-in="direction"]'),
      projectType: form.querySelector('[data-in="projectType"]'),
      budget: form.querySelector('[data-in="budget"]'),
      timeline: form.querySelector('[data-in="timeline"]'),
    };
    const state = { direction: '', projectType: '', budget: '', timeline: '' };
    const labels = {};
    let cur = 0;

    // ---- live estimate ----
    const estBox = form.querySelector('[data-estimate]');
    const estWeeks = form.querySelector('[data-estimate-weeks]');
    const estBudget = form.querySelector('[data-estimate-budget]');
    const estBar = form.querySelector('[data-estimate-bar]');
    const budgetHint = form.querySelector('[data-budget-hint]');
    const maxWeeks = 14;
    let typeIdx = -1;
    let pickedTier = -1;

    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
    const currentEstimate = () => (estimates[state.direction] || [])[typeIdx] || null;

    const renderEstimate = () => {
      const e = currentEstimate();
      estBox.hidden = !e;
      if (!e) { budgetHint.hidden = true; return; }
      const [min, max] = e.weeks;
      const budget = budgetLabels[e.budgetTier];
      const unit = est.weekUnits[new Intl.PluralRules(lang).select(max)] || est.weekUnits.other;
      estWeeks.textContent = fill(est.weeks, { min, max, unit });
      estBudget.textContent = fill(est.budget, { budget });
      estBar.style.width = Math.round((max / maxWeeks) * 100) + '%';
      const low = pickedTier >= 0 && pickedTier < e.budgetTier;
      budgetHint.hidden = !low;
      if (low) budgetHint.textContent = fill(est.budgetLow, { budget });
    };

    const valid = (i) => {
      const key = steps[i].dataset.key;
      if (key === 'contacts') {
        return [...form.querySelectorAll('[data-field]')].every((f) => f.value.trim());
      }
      return !!state[key];
    };

    const updateChips = () => {
      const vals = [labels.direction, labels.projectType, labels.budget, labels.timeline].filter(Boolean);
      chipsBox.replaceChildren(
        ...vals.map((v) => {
          const chip = document.createElement('span');
          chip.className = 'bg-ink px-3 py-1.5 t-small font-semibold text-white';
          chip.textContent = v;
          return chip;
        }),
      );
    };

    const checkSvg =
      '<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

    const render = () => {
      steps.forEach((s, i) => s.classList.toggle('hidden', i !== cur));
      const active = steps[cur];
      active.classList.remove('step-enter');
      void active.offsetWidth;
      active.classList.add('step-enter');
      stepNum.textContent = String(cur + 1);
      dots.forEach((d, i) => { d.dataset.state = i === cur ? 'active' : i < cur ? 'done' : 'todo'; });

      navItems.forEach((item, i) => {
        const circle = item.querySelector('[data-nav-circle]');
        const label = item.querySelector('[data-nav-label]');
        const done = i < cur;
        const isActive = i === cur;
        circle.className =
          'grid size-6 shrink-0 place-items-center rounded-full t-small font-bold ' +
          (done || isActive ? 'bg-ink text-white' : 'border-2 border-ink/35 text-ink/60');
        circle.innerHTML = done ? checkSvg : String(i + 1);
        label.className = 't-body ' + (isActive ? 'font-bold' : done ? 'font-medium' : 'font-medium text-ink/60');
      });

      backBtn.classList.toggle('invisible', cur === 0);
      const last = cur === total - 1;
      actionLabel.textContent = last ? submitLabel : nextLabel;
      actionArrow.classList.toggle('hidden', last);
      if (last) updateChips();
      actionBtn.disabled = !valid(cur);
    };

    const showTypeGroup = (dir) => {
      form.querySelectorAll('[data-type-group]').forEach((g) => {
        const match = g.dataset.dir === dir;
        g.classList.toggle('hidden', !match);
        g.classList.toggle('grid', match);
      });
    };

    form.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-opt]');
      if (!btn) return;
      const panel = btn.closest('[data-step]');
      const key = panel.dataset.key;
      panel.querySelectorAll('[data-opt]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      state[key] = btn.dataset.value;
      labels[key] = btn.dataset.label;
      if (hidden[key]) hidden[key].value = btn.dataset.label;

      if (key === 'projectType') typeIdx = Number(btn.dataset.idx);
      if (key === 'budget') pickedTier = Number(btn.dataset.tier);

      if (key === 'direction') {
        typeIdx = -1;
        showTypeGroup(btn.dataset.value);
        state.projectType = '';
        labels.projectType = '';
        hidden.projectType.value = '';
        form.querySelectorAll('[data-type-group] [data-opt]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      }
      renderEstimate();
      actionBtn.disabled = !valid(cur);
    });

    form.querySelectorAll('[data-field]').forEach((f) =>
      f.addEventListener('input', () => { actionBtn.disabled = !valid(cur); })
    );

    actionBtn.addEventListener('click', () => {
      if (!valid(cur)) return;
      if (cur < total - 1) { cur++; render(); }
      else form.requestSubmit();
    });
    backBtn.addEventListener('click', () => { if (cur > 0) { cur--; render(); } });

    render();
  });
</script>
