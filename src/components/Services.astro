---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ServiceDemo from './ServiceDemo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// one flat field per service: ground + ink, in poster order
const fields = [
  { bg: 'bg-blue', ink: 'text-white' },
  { bg: 'bg-red', ink: 'text-ink' },
  { bg: 'bg-black', ink: 'text-white' },
  { bg: 'bg-navy', ink: 'text-white' },
];
---

<!-- Services as statements on colour fields: the phrase is the heading,
     small text + a live demo sit at the opposite corner. -->
<section id="services" class="scroll-mt-16 md:scroll-mt-20">
  {t.services.items.map((s, i) => {
    const f = fields[i % fields.length];
    const mirrored = i % 2 === 1;
    return (
      <article data-field class:list={['svc-field', f.bg, f.ink]}>
        <div class="mx-auto flex min-h-[64svh] max-w-[1440px] flex-col justify-between gap-10 px-5 py-10 md:px-8 lg:grid lg:min-h-[80svh] lg:grid-cols-12 lg:gap-x-8 lg:py-14">
          <div
            data-reveal
            class:list={[
              'flex max-w-[460px] flex-col gap-6 lg:row-start-1 lg:self-start',
              mirrored ? 'ml-auto items-end text-right lg:col-span-5 lg:col-start-1 lg:ml-0 lg:items-start lg:text-left' : 'lg:col-span-5 lg:col-start-8',
            ]}
          >
            <p class="t-body max-w-[34ch] font-medium">{s.text}</p>
            <ServiceDemo variant={i} />
          </div>
          <h2
            data-reveal
            style="--reveal-delay: 90ms"
            class:list={[
              't-display max-w-[11ch] lg:row-start-2 lg:self-end',
              mirrored ? 'lg:col-span-8 lg:col-start-5 lg:ml-auto lg:text-right' : 'lg:col-span-8',
            ]}
          >
            {s.phrase}
          </h2>
        </div>
      </article>
    );
  })}
</section>

<script is:inline>
  // play each field's demo while it is on screen
  (() => {
    const fields = document.querySelectorAll('[data-field]');
    if (!('IntersectionObserver' in window)) {
      fields.forEach((f) => f.classList.add('sd-play'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('sd-play', e.isIntersecting)),
      { threshold: 0.35 },
    );
    fields.forEach((f) => io.observe(f));
  })();
</script>
