---
import type { CaseItem } from '../i18n/ui';

/**
 * Framed preview of a case, drawn as a neutral mock-up in brand colours
 * (real screenshots fight the page palette — swap back once proper shots exist).
 * Website (has url/imageMobile): a browser window on soft paper, a phone peeking from the bottom.
 * App: two phones floating on brand orange.
 * Parallax on hover comes from .case-* rules in global.css.
 */
interface Props {
  item: CaseItem;
  /** smaller frame for the statement block */
  compact?: boolean;
}
const { item, compact = false } = Astro.props;
const isSite = Boolean(item.imageMobile);
---

{isSite ? (
  <div class="case-media relative size-full overflow-hidden bg-paper-deep" role="img" aria-label={item.imageAlt} data-ui>
    <div data-parallax="0.05" class:list={['case-window absolute overflow-hidden rounded-[12px] bg-white shadow-[0_30px_60px_-30px_rgba(13,13,13,0.25)]', compact ? 'left-[6%] top-[8%] w-[88%]' : 'left-[6%] top-[9%] w-[78%]']}>
      <div class="flex h-5 items-center gap-1 border-b border-ink/5 px-2.5 md:h-6" aria-hidden="true">
        <span class="size-1.5 rounded-full bg-ink/15"></span>
        <span class="size-1.5 rounded-full bg-ink/15"></span>
        <span class="size-1.5 rounded-full bg-ink/15"></span>
        <span class="mx-auto h-2 w-1/3 rounded-full bg-ink/5"></span>
      </div>
      <div class="flex aspect-[16/10] flex-col gap-[5%] p-[5%]">
        <div class="flex items-center gap-[3%]">
          <span class="size-[3.5%] rounded-full bg-ink"></span>
          <span class="h-[0.5em] w-[9%] rounded-full bg-ink/10"></span>
          <span class="h-[0.5em] w-[9%] rounded-full bg-ink/10"></span>
          <span class="h-[0.5em] w-[9%] rounded-full bg-ink/10"></span>
          <span class="ml-auto h-[1.1em] w-[14%] rounded-full bg-accent"></span>
        </div>
        <div class="flex flex-1 gap-[5%]">
          <div class="flex flex-1 flex-col justify-center gap-[6%]">
            <span class="h-[14%] w-[95%] rounded-full bg-ink"></span>
            <span class="h-[14%] w-[70%] rounded-full bg-ink"></span>
            <span class="mt-[4%] h-[5%] w-[85%] rounded-full bg-ink/10"></span>
            <span class="h-[5%] w-[60%] rounded-full bg-ink/10"></span>
            <span class="mt-[6%] h-[14%] w-[38%] rounded-full bg-accent"></span>
          </div>
          <div class="relative flex-1 overflow-hidden rounded-[8%] bg-accent">
            <span class="absolute -right-[20%] -top-[25%] aspect-square w-[85%] rounded-full bg-accent-soft/60"></span>
            <span class="absolute bottom-[12%] left-[12%] aspect-square w-[34%] rounded-full bg-white"></span>
          </div>
        </div>
        <div class="grid h-[18%] grid-cols-3 gap-[3%]">
          <span class="rounded-[10%] bg-paper"></span>
          <span class="rounded-[10%] bg-paper"></span>
          <span class="rounded-[10%] bg-paper"></span>
        </div>
      </div>
    </div>
    {!compact && (
      <div data-parallax="-0.12" class="case-phone absolute bottom-[-14%] right-[6%] aspect-[9/19] w-[22%] overflow-hidden rounded-[18px] border-[5px] border-ink bg-white md:rounded-[24px] md:border-[6px]" aria-hidden="true">
        <div class="flex h-full flex-col gap-[6%] p-[10%] pt-[18%]">
          <span class="h-[5%] w-[60%] rounded-full bg-ink"></span>
          <span class="h-[5%] w-[40%] rounded-full bg-ink"></span>
          <span class="mt-[4%] aspect-square w-full rounded-[14%] bg-accent"></span>
          <span class="h-[3%] w-[80%] rounded-full bg-ink/10"></span>
          <span class="h-[7%] w-[55%] rounded-full bg-accent"></span>
        </div>
      </div>
    )}
  </div>
) : (
  <div class="case-media relative size-full overflow-hidden bg-accent" role="img" aria-label={item.imageAlt} data-ui>
    <span data-parallax="0.15" class="absolute -bottom-[30%] -left-[15%] aspect-square w-[70%] rounded-full bg-white/10" aria-hidden="true"></span>
    <div class="case-float absolute inset-0 flex items-center justify-center gap-[4%]" aria-hidden="true">
      {[0, 1].map((p) => (
        <div data-parallax={p === 0 ? '0.06' : '-0.08'} class:list={['aspect-[9/19] h-[78%] overflow-hidden rounded-[22px] border-[6px] border-ink bg-white md:rounded-[30px] md:border-[7px]', p === 0 ? '-rotate-6' : 'rotate-6']}>
          {p === 0 ? (
            <div class="flex h-full flex-col gap-[5%] bg-paper p-[9%] pt-[18%]">
              <span class="h-[4%] w-[55%] rounded-full bg-ink"></span>
              {[0, 1, 2].map(() => (
                <div class="flex items-center gap-[8%] rounded-[12%] bg-white p-[8%]">
                  <span class="aspect-square w-[28%] rounded-[30%] bg-accent-soft"></span>
                  <div class="flex flex-1 flex-col gap-[14%]">
                    <span class="h-[0.35em] w-full rounded-full bg-ink/70"></span>
                    <span class="h-[0.35em] w-[60%] rounded-full bg-ink/15"></span>
                  </div>
                </div>
              ))}
              <div class="mt-auto flex justify-around rounded-full bg-white py-[6%]">
                <span class="size-[0.6em] rounded-full bg-accent"></span>
                <span class="size-[0.6em] rounded-full bg-ink/15"></span>
                <span class="size-[0.6em] rounded-full bg-ink/15"></span>
              </div>
            </div>
          ) : (
            <div class="flex h-full flex-col gap-[5%] p-[9%] pt-[18%]">
              <span class="aspect-[4/3] w-full rounded-[12%] bg-accent"></span>
              <span class="h-[4%] w-[70%] rounded-full bg-ink"></span>
              <span class="h-[2.5%] w-[90%] rounded-full bg-ink/10"></span>
              <span class="h-[2.5%] w-[65%] rounded-full bg-ink/10"></span>
              <span class="mt-auto h-[8%] w-full rounded-full bg-ink"></span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
)}
