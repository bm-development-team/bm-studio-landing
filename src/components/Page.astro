---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Statement from './Statement.astro';
import Services from './Services.astro';
import Cases from './Cases.astro';
import Process from './Process.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { buildJsonLd } from '../lib/seo';
import Faq from './Faq.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = new URL(localizePath('/', lang), Astro.site).toString();
const jsonLd = buildJsonLd(t, lang, siteUrl, pageUrl);
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  basePath="/"
  jsonLd={jsonLd}
>
  <Header lang={lang} />
  <main id="top" class="scroll-mt-20 overflow-x-clip">
    <Hero lang={lang} />
    <Statement lang={lang} />
    <Services lang={lang} />
    <Cases lang={lang} />
    <Process lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
