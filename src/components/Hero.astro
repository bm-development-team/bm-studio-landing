---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.hero;
---

<!-- Hero, Lusion-style: one sentence on the paper, then a card that is only the 3D scene,
     and a quiet row of crosses with the scroll hint under it. No text over the shapes. -->
<section class="px-3 pb-6 pt-4 md:px-8 md:pt-0">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid px-1 lg:grid-cols-12 lg:gap-x-8">
      <h1 class="after-mask max-w-[30ch] text-[clamp(1.5rem,1.1rem+1.25vw,2.3rem)] font-medium leading-[1.08] tracking-[-0.035em] text-ink md:-mt-[52px] md:max-w-[min(30ch,56vw)] lg:col-span-6 lg:col-start-4 lg:-mt-[54px]">
        {h.lead}
      </h1>
    </div>

    <div
      data-hero-card
      class="hero-card card relative mt-6 h-[calc(100svh-17rem)] min-h-[380px] overflow-hidden md:mt-8 md:h-[calc(100svh-15.5rem)] md:min-h-[440px]"
    ></div>

    <div class="mt-4 flex items-center justify-between px-1 text-ink" aria-hidden="true">
      <span class="cross"></span>
      <span class="cross hidden md:block"></span>
      <span class="hero-scroll t-micro flex items-center gap-2">{h.scroll}</span>
      <span class="cross hidden md:block"></span>
      <span class="cross"></span>
    </div>
  </div>
</section>

<script>
  // load three.js only after first paint, and only if WebGL is there
  const card = document.querySelector<HTMLElement>('[data-hero-card]');
  const hasGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();
  if (card && hasGL) {
    const start = () =>
      import('../scripts/hero3d')
        .then(({ mountHero }) => mountHero(card))
        .catch((err: unknown) => {
          // the card still reads fine without the scene
          card.dataset.heroError = err instanceof Error ? err.message : 'failed';
        });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 300);
  }
</script>
