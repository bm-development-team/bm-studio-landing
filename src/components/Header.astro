---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const tel = t.contact.phone.replace(/[^+\d]/g, '');

const nav = [
  { label: t.nav.services, href: '#services' },
  { label: t.nav.cases, href: '#cases' },
  { label: t.nav.process, href: '#process' },
];
---

<!-- Header: wordmark left, pills right, nothing in the middle (the hero sentence sits there at the top).
     Transparent at the very top, frosted once the page scrolls. Sections live behind the MENU sheet. -->
<header data-header class="site-header sticky top-0 z-50 text-ink backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-4 px-4 md:h-[72px] md:px-8">
    <a href="/" class="group flex items-center gap-2.5" aria-label="BM Studio">
      <img src="/assets/icons/logo.svg" alt="" width="34" height="15" class="-rotate-12 transition-transform duration-700 group-hover:-rotate-[32deg]" aria-hidden="true" />
      <span class="whitespace-nowrap text-[19px] font-semibold leading-none tracking-[-0.03em] md:text-[21px]">BM Studio</span>
    </a>


    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} basePath="/" label={t.a11y.langSwitch} />
      <a href="#contact" class="header-cta pill hidden bg-ink text-white hover:bg-accent md:inline-flex">
        {t.header.cta} <span class="pill-dot" aria-hidden="true"></span>
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        class="pill bg-white text-ink"
      >
        <span data-menu-open>{t.footer.menu}</span>
        <span data-menu-close class="hidden" aria-hidden="true">✕</span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <!-- phone menu: an ink sheet under the bar filling the screen; big numbered links rise in -->
  <div id="site-menu" data-menu class="absolute inset-x-0 top-full flex h-[calc(100svh-4rem)] flex-col bg-night px-4 pb-6 pt-6 text-white md:left-auto md:right-8 md:top-[calc(100%+0.5rem)] md:h-auto md:w-[440px] md:rounded-[28px] md:px-8 md:pb-8">
    <nav class="flex flex-col" aria-label="Mobile">
      {nav.map((item, i) => (
        <a href={item.href} data-menu-link class="group flex items-baseline gap-4 border-b border-white/10 py-4">
          <span class="menu-rise t-micro text-white/45"><span style={`--i: ${i}`}>0{i + 1}</span></span>
          <span class="menu-rise text-[clamp(2.75rem,12vw,4rem)] font-medium leading-[0.95] tracking-[-0.05em]"><span style={`--i: ${i}`}>{item.label}</span></span>
        </a>
      ))}
    </nav>
    <div class="mt-auto flex flex-col gap-5 md:mt-8">
      <span class="menu-rise"><span style="--i: 3">
        <span class="t-body flex flex-col items-start text-white/70">
          <a href={`tel:${tel}`} class="py-1 text-white">{t.contact.phone}</a>
          <a href={`mailto:${t.contact.email}`} class="py-1">{t.contact.email}</a>
        </span>
      </span></span>
      <span class="menu-rise"><span style="--i: 4">
        <a href="#contact" data-menu-link class="pill pill-lg w-full bg-accent text-white">
          {t.header.cta} <span class="pill-dot" aria-hidden="true"></span>
        </a>
      </span></span>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-menu]');
    if (!toggle || !menu) return;
    const openIcon = toggle.querySelector('[data-menu-open]');
    const closeIcon = toggle.querySelector('[data-menu-close]');

    const header = document.querySelector('[data-header]');
    const isOpen = () => menu.classList.contains('is-open');
    const setOpen = (open) => {
      menu.classList.toggle('is-open', open);
      header?.classList.toggle('menu-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      toggle.setAttribute('aria-expanded', String(open));
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) setOpen(false); });
    menu.querySelectorAll('[data-menu-link]').forEach((l) => l.addEventListener('click', () => setOpen(false)));

    // go dark while a dark section ([data-dark]) sits under the bar.
    // the header renders before those sections, so wait for the whole document.
    // transparent while the page sits at the very top, so the hero sentence can share the bar
    const headerEl = document.querySelector('[data-header]');
    const top = () => headerEl?.classList.toggle('is-top', window.scrollY < 8);
    window.addEventListener('scroll', top, { passive: true });
    top();

    const watchDark = () => {
      const header = document.querySelector('[data-header]');
      const darks = document.querySelectorAll('[data-dark]');
      if (!header || !darks.length || !('IntersectionObserver' in window)) return;
      const under = new Set();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
          header.classList.toggle('is-dark', under.size > 0);
        },
        { rootMargin: '0px 0px -92% 0px' },
      );
      darks.forEach((d) => io.observe(d));
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watchDark);
    else watchDark();
  })();
</script>
