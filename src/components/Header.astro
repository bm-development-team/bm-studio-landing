---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { label: t.nav.services, href: '#services' },
  { label: t.nav.cases, href: '#cases' },
  { label: t.nav.process, href: '#process' },
];
---

<!-- Header: wordmark left, quiet links centre, pills right. Floats over the lavender paper. -->
<header data-header class="site-header sticky top-0 z-50 text-ink backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-4 px-4 md:h-[72px] md:px-8">
    <a href="/" class="group flex items-center gap-2.5" aria-label="BM Studio">
      <img src="/assets/icons/logo.svg" alt="" width="34" height="15" class="-rotate-12 transition-transform duration-700 group-hover:-rotate-[32deg]" aria-hidden="true" />
      <span class="whitespace-nowrap text-[19px] font-semibold leading-none tracking-[-0.03em] md:text-[21px]">BM Studio</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class="t-small font-medium opacity-70 transition-opacity hover:opacity-100">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} basePath="/" label={t.a11y.langSwitch} />
      <a href="#contact" class="header-cta pill hidden bg-ink text-white hover:bg-blue md:inline-flex">
        {t.header.cta} <span class="pill-dot" aria-hidden="true"></span>
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        class="pill bg-white text-ink md:hidden"
      >
        <span data-menu-open>{t.footer.menu}</span>
        <span data-menu-close class="hidden" aria-hidden="true">✕</span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <!-- mobile menu: a white rounded sheet under the bar -->
  <div id="site-menu" data-menu class="hidden px-3 pb-3 md:hidden">
    <nav class="card flex flex-col bg-white p-5" aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} data-menu-link class="py-1.5 text-[40px] font-medium leading-[1.05] tracking-[-0.04em] text-ink">{item.label}</a>
      ))}
      <a href="#contact" data-menu-link class="pill pill-lg mt-6 bg-ink text-white">
        {t.header.cta} <span class="pill-dot" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-menu]');
    if (!toggle || !menu) return;
    const openIcon = toggle.querySelector('[data-menu-open]');
    const closeIcon = toggle.querySelector('[data-menu-close]');

    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('[data-menu-link]').forEach((l) => l.addEventListener('click', () => setOpen(false)));
    window.addEventListener('resize', () => { if (window.innerWidth >= 768) setOpen(false); });

    // go dark while a dark section ([data-dark]) sits under the bar.
    // the header renders before those sections, so wait for the whole document.
    const watchDark = () => {
      const header = document.querySelector('[data-header]');
      const darks = document.querySelectorAll('[data-dark]');
      if (!header || !darks.length || !('IntersectionObserver' in window)) return;
      const under = new Set();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
          header.classList.toggle('is-dark', under.size > 0);
        },
        { rootMargin: '0px 0px -92% 0px' },
      );
      darks.forEach((d) => io.observe(d));
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watchDark);
    else watchDark();
  })();
</script>
