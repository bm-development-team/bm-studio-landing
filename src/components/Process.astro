---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProcessPhone from './ProcessPhone.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// order is carried by colour: darkest blue first, each stage a lighter flat tint
const tints = [
  'bg-[#050a5c] text-white',
  'bg-[#0b1590] text-white',
  'bg-[#1726d6] text-white',
  'bg-[#2033f7] text-white',
  'bg-[#7c87ff] text-ink',
  'bg-[#c3c8ff] text-ink',
];
---

<!-- How we work: an accordion of tinted stages. Phone: vertical bars. Desktop: horizontal slivers.
     The single phone mock moves into whichever stage is open. -->
<section id="process" class="scroll-mt-16 bg-white py-16 md:scroll-mt-20 md:py-24 lg:py-32" data-process>
  <div class="mx-auto max-w-[1440px] px-5 md:px-8">
    <div class="grid gap-5 lg:grid-cols-12 lg:gap-x-8">
      <h2 data-reveal class="t-head text-ink lg:col-span-6">{t.process.heading}</h2>
      <p data-reveal style="--reveal-delay: 90ms" class="t-lead max-w-[36ch] font-medium text-ink lg:col-span-5 lg:col-start-8 lg:self-end">{t.process.lead}</p>
    </div>

    <!-- desktop: a tall track; the accordion sticks while the scroll through it picks the open stage -->
    <div class="mt-10 lg:mt-16 lg:h-[calc(600px+300svh)]" data-process-track>
    <ol class="flex flex-col lg:sticky lg:top-[max(6rem,calc((100svh-600px)/2))] lg:h-[600px] lg:flex-row" data-stages>
      {t.process.steps.map((step, i) => (
        <li class:list={['stage lg:flex lg:flex-col', tints[i], i === 0 && 'is-open']} data-stage={i} data-process-step={i}>
          <h3 class="lg:h-full lg:[.is-open>&]:h-auto">
            <button
              type="button"
              data-stage-btn
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`stage-${i}`}
              class="flex h-16 w-full items-center justify-between gap-4 px-5 text-left t-lead font-extrabold tracking-[-0.02em] focus:outline-none focus-visible:outline-3 focus-visible:-outline-offset-4 focus-visible:outline-current lg:h-full lg:items-start lg:px-0 lg:py-6"
            >
              <span class="stage-name-h lg:px-8">{step.title}</span>
              <span class="stage-name-v hidden lg:mx-auto lg:block">{step.title}</span>
              <span class="stage-sign text-[28px] leading-none lg:hidden" aria-hidden="true">{i === 0 ? '−' : '+'}</span>
            </button>
          </h3>
          <div class="stage-body lg:flex-1" id={`stage-${i}`}>
            <div>
              <div class="flex flex-col gap-6 px-5 pb-8 lg:h-full lg:flex-row lg:items-end lg:justify-between lg:px-8 lg:pb-8">
                <p class="t-body max-w-[36ch] font-medium">{step.description}</p>
                <div class="pp-slot self-center lg:self-end" data-phone-slot>
                  {i === 0 && (
                    <div class="h-[348px] w-[169px] lg:h-[437px] lg:w-[212px]" data-phone-holder>
                      <div class="origin-top-left scale-[0.62] lg:scale-[0.78]">
                        <ProcessPhone />
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-process]');
    if (!section) return;
    const stages = [...section.querySelectorAll('[data-stage]')];
    const holder = section.querySelector('[data-phone-holder]');
    const phone = section.querySelector('[data-process-phone]');
    const screens = [...phone.querySelectorAll('.pp-screen')];

    const track = section.querySelector('[data-process-track]');
    const desktop = window.matchMedia('(min-width: 1024px)');
    let current = -1;

    const open = (i) => {
      if (i === current) return;
      current = i;
      stages.forEach((s, n) => {
        const isOpen = n === i;
        s.classList.toggle('is-open', isOpen);
        const btn = s.querySelector('[data-stage-btn]');
        btn.setAttribute('aria-expanded', String(isOpen));
        const sign = s.querySelector('.stage-sign');
        if (sign) sign.textContent = isOpen ? '−' : '+';
      });
      stages[i].querySelector('[data-phone-slot]').appendChild(holder);
      phone.dataset.active = String(i);
      screens.forEach((s, n) => s.classList.toggle('is-active', n === i));
    };

    // desktop: progress through the track → stage index
    const progress = () => {
      const r = track.getBoundingClientRect();
      const distance = track.offsetHeight - window.innerHeight;
      return distance > 0 ? Math.min(1, Math.max(0, -r.top / distance)) : 0;
    };
    const stageFromScroll = () => Math.min(stages.length - 1, Math.floor(progress() * stages.length));

    let ticking = false;
    const onScroll = () => {
      if (ticking || !desktop.matches) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; open(stageFromScroll()); });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    // click: on desktop scroll to that stage's slice of the track; on phones just open it
    stages.forEach((s, i) =>
      s.querySelector('[data-stage-btn]').addEventListener('click', () => {
        if (!desktop.matches) { open(i); return; }
        const distance = track.offsetHeight - window.innerHeight;
        const top = track.getBoundingClientRect().top + window.scrollY;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: top + distance * ((i + 0.5) / stages.length), behavior: reduce ? 'auto' : 'smooth' });
        open(i);
      }),
    );
    open(desktop.matches ? stageFromScroll() : 0);
  })();
</script>
