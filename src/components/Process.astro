---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProcessPhone from './ProcessPhone.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = t.process.steps;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- How we work: plain scroll, no hijacking.
     Desktop: a blue panel sticks on the left (big number, phone with the stage screen);
     the steps list scrolls on the right and the row in the middle of the screen lights up.
     Phone: a simple readable list. -->
<section id="process" data-dark class="scroll-mt-16 bg-night px-4 py-20 text-white md:scroll-mt-20 md:px-8 md:py-32" data-process>
  <div class="mx-auto max-w-[1440px]">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-x-8">
      <h2 data-reveal class="t-head lg:col-span-6">{t.process.heading}</h2>
      <p data-reveal style="--reveal-delay: 90ms" class="t-body max-w-[40ch] text-white/65 lg:col-span-4 lg:col-start-9">{t.process.lead}</p>
    </div>

    <div class="mt-12 grid gap-x-8 md:mt-16 lg:grid-cols-12">
      <div class="hidden lg:col-span-5 lg:block">
        <div class="card sticky top-24 flex h-[min(640px,calc(100svh-8rem))] flex-col overflow-hidden bg-blue p-8" data-process-panel aria-hidden="true">
          <div class="flex items-start justify-between">
            <span class="text-[clamp(5rem,3rem+5vw,8.5rem)] font-medium leading-[0.8] tracking-[-0.06em]" data-panel-num>01</span>
            <span class="t-micro text-white/70">/ {pad(steps.length)}</span>
          </div>
          <p class="mt-4 text-[clamp(1.5rem,1.1rem+0.8vw,2rem)] font-medium leading-none tracking-[-0.03em]" data-panel-title>{steps[0].title}</p>
          <div class="relative mt-auto flex justify-center">
            <div class="-mb-[230px] origin-top scale-[0.8]">
              <ProcessPhone active={0} />
            </div>
          </div>
        </div>
      </div>

      <ol class="flex flex-col lg:col-span-6 lg:col-start-7" data-stages>
        {steps.map((step, i) => (
          <li
            class:list={['step-row border-t border-white/12 py-5 md:py-10 lg:flex lg:min-h-[46svh] lg:flex-col lg:justify-center', i === 0 && 'is-active is-open', i === steps.length - 1 && 'border-b']}
            data-stage={i}
            data-title={step.title}
          >
            <!-- phones: the head toggles the body (one open at a time); desktop: always open -->
            <h3>
              <button type="button" class="flex w-full items-center gap-4 text-left lg:pointer-events-none lg:block" data-step-toggle aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`step-body-${i}`}>
                <span class="flex items-center gap-3 lg:mb-4">
                  <span class="t-micro text-white/55">{pad(i + 1)}</span>
                  <span class="t-micro hidden rounded-full bg-white/10 px-3 py-1.5 text-white/85 lg:inline-flex">{step.duration}</span>
                </span>
                <span class="block flex-1 text-[clamp(1.6rem,1.2rem+2.2vw,3.5rem)] font-medium leading-[0.95] tracking-[-0.045em]">{step.title}</span>
                <span class="t-micro shrink-0 text-white/55 lg:hidden">{step.duration}</span>
                <span class="step-sign relative size-8 shrink-0 rounded-full bg-white/10 lg:hidden" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="step-body" id={`step-body-${i}`}><div>
              <p class="t-lead mt-4 max-w-[34ch] text-white/75">{step.description}</p>
              <ul class="mt-5 grid gap-2 sm:grid-cols-3 md:mt-6">
                {step.points.map((point) => (
                  <li class="t-small flex items-center gap-2 text-white/85">
                    <span class="size-1.5 shrink-0 rounded-full bg-blue-soft" aria-hidden="true"></span>{point}
                  </li>
                ))}
              </ul>
            </div></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-process]');
    if (!section) return;
    const rows = [...section.querySelectorAll('[data-stage]')];

    // phones: accordion, one step open at a time
    rows.forEach((row) => {
      const btn = row.querySelector('[data-step-toggle]');
      btn?.addEventListener('click', () => {
        if (window.matchMedia('(min-width: 1024px)').matches) return;
        const open = !row.classList.contains('is-open');
        rows.forEach((r) => {
          const on = r === row && open;
          r.classList.toggle('is-open', on);
          r.querySelector('[data-step-toggle]')?.setAttribute('aria-expanded', String(on));
        });
      });
    });

    if (!('IntersectionObserver' in window)) return;
    const num = section.querySelector('[data-panel-num]');
    const title = section.querySelector('[data-panel-title]');
    const screens = [...section.querySelectorAll('[data-process-panel] .pp-screen')];
    const phone = section.querySelector('[data-process-panel] [data-process-phone]');
    let current = 0;

    const activate = (i) => {
      if (i === current) return;
      current = i;
      rows.forEach((r, n) => r.classList.toggle('is-active', n === i));
      screens.forEach((s, n) => s.classList.toggle('is-active', n === i));
      if (phone) phone.dataset.active = String(i);
      if (num) num.textContent = String(i + 1).padStart(2, '0');
      if (title) title.textContent = rows[i].dataset.title;
    };

    // the row crossing the middle band of the viewport is the active one
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) activate(rows.indexOf(e.target)); }),
      { rootMargin: '-45% 0px -45% 0px' },
    );
    rows.forEach((r) => io.observe(r));
  })();
</script>
