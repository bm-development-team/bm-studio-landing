---
import { type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProcessScenes from './ProcessScenes.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = t.process.steps;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- How we work: plain scroll, no hijacking.
     Desktop: an orange panel sticks on the left (big number, the 2-week prototype offer with a progress bar,
     and a scene per stage);
     the steps list scrolls on the right and the row in the middle of the screen lights up.
     Phone: a simple readable list. -->
<section id="process" class="scroll-mt-16 px-3 md:scroll-mt-20 md:px-8" data-process>
  <div data-dark class="card mx-auto max-w-[1440px] bg-night px-4 py-16 text-white md:px-10 md:py-24">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-x-8">
      <h2 data-split class="t-head lg:col-span-7">{t.process.heading}</h2>
      <p data-reveal style="--reveal-delay: 90ms" class="t-body max-w-[38ch] text-white/60 lg:col-span-4 lg:col-start-9 lg:pb-2">{t.process.lead}</p>
    </div>

    <div class="mt-12 grid gap-x-8 md:mt-16 lg:grid-cols-12">
      <div class="hidden lg:col-span-5 lg:block">
        <div class="card sticky top-24 flex h-[min(760px,calc(100svh-7.5rem))] flex-col overflow-hidden bg-accent p-8" data-process-panel aria-hidden="true">
          <div class="flex items-start justify-between">
            <span class="text-[clamp(5rem,3rem+5vw,8.5rem)] font-medium leading-[0.8] tracking-[-0.06em]" data-panel-num>01</span>
            <span class="t-micro text-white/70">/ {pad(steps.length)}</span>
          </div>
          <p class="mt-4 text-[clamp(1.5rem,1.1rem+0.8vw,2rem)] font-medium leading-none tracking-[-0.03em]" data-panel-title>{steps[0].title}</p>
          <!-- the offer: six segments fill as you scroll; the prototype milestone sits after the structure step -->
          <div class="mt-7 flex flex-col gap-3">
            <p class="max-w-[16ch] text-[clamp(1.6rem,1rem+1.3vw,2.5rem)] font-medium leading-[1] tracking-[-0.035em]">{t.process.offer}</p>
            <div class="relative grid grid-cols-6 gap-1.5 pb-8">
              {steps.map((_, n) => (
                <span class:list={['pp-seg h-1.5 overflow-hidden rounded-full bg-white/25', { 'is-on': n === 0 }]} data-seg={n}><span class="block h-full rounded-full bg-white"></span></span>
              ))}
              <span class="pp-mile absolute left-1/2 top-[-5px] flex -translate-x-1/2 flex-col items-center gap-1.5" data-milestone>
                <span class="pp-mile-dot size-4 rounded-full border-[3px] border-white bg-accent"></span>
                <span class="pp-mile-tag whitespace-nowrap rounded-full bg-white/20 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.06em]">★ {t.process.prototype}</span>
              </span>
            </div>
          </div>
          <!-- a different composition per step, bleeding off the panel's bottom edge -->
          <div class="relative -mx-8 -mb-8 mt-2 min-h-[300px] flex-1 overflow-hidden">
            <ProcessScenes active={0} lang={lang} />
          </div>
        </div>
      </div>

      <ol class="relative flex flex-col pl-8 lg:col-span-6 lg:col-start-7 lg:pl-0" data-stages>
        <!-- phones: a timeline on the left fills as you scroll -->
        <span class="absolute bottom-0 left-[9px] top-0 w-0.5 rounded-full bg-white/10 lg:hidden" aria-hidden="true">
          <span class="block h-0 w-full rounded-full bg-accent" data-process-line></span>
        </span>
        {steps.map((step, i) => (
          <li
            class:list={['step-row relative border-t border-white/12 py-5 md:py-10 lg:flex lg:min-h-[46svh] lg:flex-col lg:justify-center', i === 0 && 'is-active is-open', i === steps.length - 1 && 'border-b']}
            data-stage={i}
            data-title={step.title}
          >
            <!-- phones: the head toggles the body (one open at a time); desktop: always open -->
            <span class="step-dot absolute -left-8 top-[1.85rem] size-5 rounded-full border-2 border-night bg-[#2a2a2a] transition-colors duration-500 md:top-[2.9rem] lg:hidden" aria-hidden="true"></span>
            <h3>
              <button type="button" class="flex w-full items-center gap-4 text-left lg:pointer-events-none lg:block" data-step-toggle aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`step-body-${i}`}>
                <span class="flex items-center gap-3 lg:mb-4">
                  <span class="t-micro text-white/55">{pad(i + 1)}</span>
                  <span class="t-micro hidden rounded-full bg-white/10 px-3 py-1.5 text-white/85 lg:inline-flex">{step.duration}</span>
                </span>
                <span class="block flex-1 text-[clamp(1.6rem,1.2rem+2.2vw,3.5rem)] font-medium leading-[0.95] tracking-[-0.045em]">{step.title}</span>
                <span class="t-micro shrink-0 text-white/55 lg:hidden">{step.duration}</span>
                <span class="step-sign relative size-8 shrink-0 rounded-full bg-white/10 lg:hidden" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="step-body" id={`step-body-${i}`}><div>
              <p class="t-lead mt-4 max-w-[34ch] text-white/75">{step.description}</p>
              <ul class="mt-5 grid gap-2 sm:grid-cols-3 md:mt-6">
                {step.points.map((point) => (
                  <li class="t-small flex items-center gap-2 text-white/85">
                    <span class="size-1.5 shrink-0 rounded-full bg-accent-soft" aria-hidden="true"></span>{point}
                  </li>
                ))}
              </ul>
            </div></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-process]');
    if (!section) return;
    const rows = [...section.querySelectorAll('[data-stage]')];

    // phones: accordion, one step open at a time
    rows.forEach((row) => {
      const btn = row.querySelector('[data-step-toggle]');
      btn?.addEventListener('click', () => {
        if (window.matchMedia('(min-width: 1024px)').matches) return;
        const open = !row.classList.contains('is-open');
        rows.forEach((r) => {
          const on = r === row && open;
          r.classList.toggle('is-open', on);
          r.querySelector('[data-step-toggle]')?.setAttribute('aria-expanded', String(on));
        });
      });
    });

    // phones: timeline fill and passed dots follow the scroll
    const line = section.querySelector('[data-process-line]');
    const list = section.querySelector('[data-stages]');
    let tick = false;
    const fill = () => {
      tick = false;
      if (!line || !list || window.matchMedia('(min-width: 1024px)').matches) return;
      const mark = window.innerHeight * 0.6;
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (mark - r.top) / r.height));
      line.style.height = (p * 100).toFixed(2) + '%';
      rows.forEach((row) => row.classList.toggle('is-passed', row.getBoundingClientRect().top < mark));
    };
    window.addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(fill); } }, { passive: true });
    fill();

    if (!('IntersectionObserver' in window)) return;
    const num = section.querySelector('[data-panel-num]');
    const title = section.querySelector('[data-panel-title]');
    const screens = [...section.querySelectorAll('[data-process-panel] .pp-screen')];
    const scenes = section.querySelector('[data-process-panel] [data-process-scenes]');
    const segs = [...section.querySelectorAll('[data-seg]')];
    const mile = section.querySelector('[data-milestone]');
    let current = 0;

    const activate = (i) => {
      if (i === current) return;
      current = i;
      rows.forEach((r, n) => r.classList.toggle('is-active', n === i));
      screens.forEach((s, n) => s.classList.toggle('is-active', n === i));
      if (scenes) scenes.dataset.active = String(i);
      segs.forEach((s, n) => s.classList.toggle('is-on', n <= i));
      if (mile) mile.classList.toggle('is-reached', i >= 2);
      if (num) num.textContent = String(i + 1).padStart(2, '0');
      if (title) title.textContent = rows[i].dataset.title;
    };

    // the row crossing the middle band of the viewport is the active one
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) activate(rows.indexOf(e.target)); }),
      { rootMargin: '-45% 0px -45% 0px' },
    );
    rows.forEach((r) => io.observe(r));
  })();
</script>
