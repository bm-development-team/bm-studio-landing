---
/**
 * Looping animated illustration for a service card (~8s cycles).
 * Base styles are the finished picture (what reduced-motion users see);
 * the loops run only while an ancestor has .sd-play (card on screen).
 * Real words (from i18n/demo.ts) instead of grey bars, so each scene reads at a glance.
 * Order matches services.items: 0 UX/UI, 1 web development, 2 landing pages, 3 redesign, 4 SEO, 5 GEO, 6 audit.
 */
import type { Lang } from '../i18n/ui';
import { demoCopy } from '../i18n/demo';

export type DemoTone = 'light' | 'dark' | 'accent';
interface Props {
  variant: number;
  lang: Lang;
  tone?: DemoTone;
}
const { variant, lang, tone = 'light' } = Astro.props;
const c = demoCopy[lang];

const stage = { light: 'bg-paper', dark: 'bg-white/[0.06]', accent: 'bg-black/[0.12]' }[tone];

const code = [
  { t: '<section class="hero">', c: '#ff9a6e', i: 0 },
  { t: '<h1>{title}</h1>', c: '#ffffff', i: 1 },
  { t: '<Button cta />', c: '#ff4f12', i: 1 },
  { t: '</section>', c: '#ff9a6e', i: 0 },
  { t: '$ deploy --prod', c: '#9ee6b8', i: 0 },
];
// SEO: our result (row 3) climbs to the top, the others step down one place
const results = [
  { from: 0, to: 1, ours: false, name: c.seo.others[0] },
  { from: 1, to: 2, ours: false, name: c.seo.others[1] },
  { from: 2, to: 3, ours: false, name: c.seo.others[2] },
  { from: 3, to: 0, ours: true, name: c.seo.ours },
];
const rings = [
  { v: 98, c: '#ff4f12' },
  { v: 92, c: '#0d0d0d' },
  { v: 95, c: '#1fbf6b' },
];
const words = c.geo.answer.split(' ');
const check = `<svg viewBox="0 0 24 24" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>`;
const search = `<svg viewBox="0 0 24 24" class="size-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4-4"/></svg>`;
const spark = `<svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>`;
const cursor = `<svg viewBox="0 0 24 24" class="size-full drop-shadow-[0_3px_4px_rgba(0,0,0,0.3)]"><path d="M4 2l15 9-6.5 1.5L10 19z" fill="#0d0d0d" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>`;
const win = 'bg-white shadow-[0_24px_48px_-24px_rgba(13,13,13,0.35)]';
---

<div data-ui data-sd class:list={['sd sd-tilt relative h-[210px] w-full overflow-hidden rounded-[18px] sm:h-[230px] lg:h-[240px]', stage]} aria-hidden="true">
  {variant === 0 && (
    <div class:list={['absolute inset-x-[16%] inset-y-[8%] flex flex-col gap-[6%] rounded-[18px] p-[6%] text-ink', win]}>
      <div class="flex items-center justify-between">
        <span class="sd-pop text-[13px] font-semibold tracking-[-0.02em]" style="--d: 0s">{c.ux.title}</span>
        <span class="sd-wire size-3 rounded-full" style="--c: #ffd4c2; --d: .15s"></span>
      </div>
      <div class="flex flex-1 items-center gap-3">
        <span class="sd-wire aspect-square h-full max-h-16 rounded-[12px]" style="--c: #ff4f12; --d: .3s"></span>
        <div class="flex flex-col gap-1">
          <span class="sd-pop text-[12px] font-medium" style="--d: .45s">{c.ux.item}</span>
          <span class="sd-pop text-[11px] text-ink/50" style="--d: .6s">{c.ux.price}</span>
        </div>
      </div>
      <span class="sd-wire sd-ux-btn relative flex h-9 shrink-0 items-center justify-center rounded-full text-[12px] font-semibold text-white" style="--c: #ff4f12; --d: .75s">
        <span class="sd-pop" style="--d: .75s">{c.ux.pay}</span>
        <span class="sd-ripple absolute inset-0 rounded-full bg-accent/40"></span>
      </span>
      <span class="sd-done absolute -right-5 -top-3 flex items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-[11px] font-medium text-white shadow-lg">
        <span class="flex size-4 items-center justify-center rounded-full bg-success"><Fragment set:html={check} /></span>{c.ux.done}
      </span>
      <span class="sd-ux-cursor absolute size-7" set:html={cursor}></span>
    </div>
  )}

  {variant === 1 && (
    <div class="absolute inset-[6%] flex gap-[4%]">
      <div class="flex flex-[1.15] flex-col gap-2 overflow-hidden rounded-[14px] border border-white/10 bg-[#141414] p-[6%] font-mono text-[10px] leading-none">
        <div class="mb-1 flex gap-1"><span class="size-1.5 rounded-full bg-white/20"></span><span class="size-1.5 rounded-full bg-white/20"></span><span class="size-1.5 rounded-full bg-white/20"></span></div>
        {code.map((l, n) => (
          <span class="sd-code overflow-hidden whitespace-nowrap" style={`--w: ${l.t.length + 1}ch; --d: ${n * 0.4}s; color: ${l.c}; margin-left: ${l.i * 1.5}ch`}>{l.t}</span>
        ))}
        <span class="sd-caret h-3 w-1 rounded-full bg-white/70"></span>
      </div>
      <div class:list={['relative flex flex-1 flex-col gap-[6%] rounded-[14px] p-[6%] text-ink', win]}>
        <span class="sd-pop text-[11px] font-bold tracking-[-0.02em]" style="--d: .8s">BM</span>
        <span class="sd-pop flex flex-[1.4] items-end rounded-[10px] bg-accent p-2 text-[13px] font-semibold leading-[1.05] tracking-[-0.03em] text-white" style="--d: 1.3s">{c.web.hero}</span>
        <div class="grid flex-1 grid-cols-3 gap-[6%]">
          <span class="sd-pop rounded-[8px] bg-paper" style="--d: 1.7s"></span>
          <span class="sd-pop rounded-[8px] bg-paper" style="--d: 1.9s"></span>
          <span class="sd-pop rounded-[8px] bg-paper" style="--d: 2.1s"></span>
        </div>
        <span class="sd-live absolute -right-1 -top-2 flex items-center gap-1.5 rounded-full bg-success px-2.5 py-1 text-[10px] font-semibold text-white shadow-lg">
          <span class="size-1.5 rounded-full bg-white"></span>{c.web.live}
        </span>
      </div>
    </div>
  )}

  {variant === 2 && (
    <div class:list={['absolute inset-x-[12%] top-[7%] bottom-0 overflow-hidden rounded-t-[16px] text-ink', win]}>
      <div class="flex h-6 items-center gap-1 border-b border-ink/5 px-3">
        <span class="size-1.5 rounded-full bg-ink/15"></span><span class="size-1.5 rounded-full bg-ink/15"></span><span class="size-1.5 rounded-full bg-ink/15"></span>
      </div>
      <div class="sd-scroll flex flex-col gap-3 p-4 text-center">
        <span class="text-[15px] font-semibold leading-[1.05] tracking-[-0.03em]">{c.landing.hero}</span>
        <span class="text-[10px] text-ink/50">{c.landing.sub}</span>
        <span class="relative h-24 shrink-0 overflow-hidden rounded-[12px] bg-accent">
          <span class="absolute -right-6 -top-8 size-24 rounded-full bg-accent-soft/50"></span>
          <span class="absolute bottom-2 left-2 rounded-full bg-white px-2 py-0.5 text-[10px] font-semibold">{c.landing.price}</span>
        </span>
        <div class="grid shrink-0 grid-cols-3 gap-2">
          <span class="h-12 rounded-[10px] bg-paper"></span><span class="h-12 rounded-[10px] bg-paper"></span><span class="h-12 rounded-[10px] bg-paper"></span>
        </div>
        <span class="flex h-16 shrink-0 items-center justify-center rounded-[12px] bg-ink text-[16px] font-semibold tracking-[-0.03em] text-white"><span class="text-accent">★</span>&nbsp;4.9</span>
        <span class="sd-cta mx-auto flex h-8 w-2/3 shrink-0 items-center justify-center rounded-full bg-accent text-[11px] font-semibold text-white">{c.landing.cta}</span>
      </div>
      <span class="sd-toast absolute right-3 top-9 flex items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-[11px] font-medium text-white shadow-lg">
        <span class="size-1.5 rounded-full bg-success"></span>{c.landing.lead}
      </span>
    </div>
  )}

  {variant === 3 && (
    <div class="absolute inset-[6%] overflow-hidden rounded-[14px] shadow-[0_24px_48px_-24px_rgba(13,13,13,0.35)]">
      <!-- before: a dull grey template -->
      <div class="absolute inset-0 flex flex-col bg-[#e6e6e2] font-[Arial,sans-serif] text-[#6b6b6b]">
        <div class="flex h-6 items-center bg-[#9a9a96] px-2 text-[8px] text-white/90">{c.redesign.oldNav}</div>
        <div class="flex flex-1 gap-2 p-[5%]">
          <span class="w-[38%] bg-[#c9c9c4]"></span>
          <div class="flex flex-1 flex-col gap-1.5">
            <span class="h-2 w-full bg-[#b5b5b0]"></span><span class="h-1.5 w-full bg-[#cfcfca]"></span><span class="h-1.5 w-full bg-[#cfcfca]"></span><span class="h-1.5 w-2/3 bg-[#cfcfca]"></span>
            <span class="mt-auto h-4 w-1/2 bg-[#b5b5b0]"></span>
          </div>
        </div>
        <span class="t-micro absolute bottom-2 left-2 rounded-full bg-white/80 px-2 py-0.5 text-[9px] text-ink/60">{c.redesign.before}</span>
      </div>
      <!-- after -->
      <div class="sd-new absolute inset-0 flex items-center gap-[6%] bg-white p-[7%] text-ink">
        <div class="flex flex-1 flex-col items-start gap-2.5">
          <span class="text-[clamp(16px,1.6vw,22px)] font-semibold leading-[0.98] tracking-[-0.04em]">{c.redesign.newHero}</span>
          <span class="h-1.5 w-3/4 rounded-full bg-ink/10"></span>
          <span class="mt-1 rounded-full bg-accent px-3 py-1.5 text-[10px] font-semibold text-white">{c.redesign.start}</span>
        </div>
        <span class="relative aspect-square w-[32%] rounded-full bg-accent">
          <span class="absolute inset-[22%] rounded-full bg-accent-soft"></span>
        </span>
        <span class="t-micro absolute bottom-2 right-2 rounded-full bg-accent px-2 py-0.5 text-[9px] text-white">{c.redesign.after}</span>
      </div>
      <span class="sd-handle absolute inset-y-0 w-0.5 -translate-x-1/2 bg-accent">
        <span class="absolute left-1/2 top-1/2 flex size-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent text-[11px] font-bold text-white shadow-lg">‹›</span>
      </span>
    </div>
  )}

  {variant === 4 && (
    <div class:list={['absolute inset-[6%] flex flex-col gap-[5%] rounded-[16px] p-[5%] text-ink', win]}>
      <div class="flex h-8 shrink-0 items-center gap-2 rounded-full bg-paper px-3 text-ink/50">
        <Fragment set:html={search} />
        <span class="sd-code overflow-hidden whitespace-nowrap text-[11px] text-ink" style={`--w: ${(c.seo.query.length * 0.82).toFixed(1)}ch; --d: 0s`}>{c.seo.query}</span>
        <span class="sd-caret h-3 w-0.5 rounded-full bg-ink/50"></span>
      </div>
      <div class="relative flex-1">
        {results.map((r) => (
          <div
            class:list={['sd-rank absolute inset-x-0 flex h-[22%] items-center gap-2 rounded-[10px] px-3 text-[11px]', r.ours ? 'z-10 bg-accent text-white shadow-[0_10px_24px_-10px_rgba(255,79,18,0.7)]' : 'bg-paper text-ink/45']}
            style={`--a: ${r.from * 26}%; --b: ${r.to * 26}%`}
          >
            <span class="font-semibold">{r.name}</span>
            {r.ours && <span class="hidden truncate text-white/75 sm:inline">{c.seo.oursSub}</span>}
            {r.ours && <span class="sd-up ml-auto shrink-0 font-semibold">▲ 1</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  {variant === 5 && (
    <div class="absolute inset-[6%] flex flex-col gap-[6%] rounded-[16px] border border-white/10 bg-[#161616] p-[5%] text-white">
      <div class="sd-pop ml-auto max-w-[72%] rounded-[14px] rounded-br-[4px] bg-white/10 px-3 py-2 text-[11px] leading-[1.3]" style="--d: 0s">{c.geo.question}</div>
      <div class="flex gap-2.5">
        <span class="sd-pop flex size-7 shrink-0 items-center justify-center rounded-full bg-accent text-white" style="--d: .8s"><Fragment set:html={spark} /></span>
        <div class="flex flex-1 flex-col items-start gap-2.5 pt-1">
          <p class="text-[11px] leading-[1.4] text-white/75">
            {words.map((w, n) => (
              <span class:list={['sd-word inline-block', w.startsWith('BM') || w.startsWith('Studio') ? 'font-semibold text-accent' : '']} style={`--d: ${1.1 + n * 0.12}s`}>{w}&nbsp;</span>
            ))}
          </p>
          <span class="sd-pop flex items-center gap-1.5 rounded-full bg-accent py-1 pl-1 pr-2.5 text-[10px] font-semibold shadow-[0_10px_24px_-10px_rgba(255,79,18,0.8)]" style={`--d: ${1.4 + words.length * 0.12}s`}>
            <span class="flex size-4 items-center justify-center rounded-full bg-white text-[8px] font-bold text-accent">BM</span>{c.geo.source} ↗
          </span>
        </div>
      </div>
    </div>
  )}

  {variant === 6 && (
    <div class="absolute inset-[6%] flex gap-[4%]">
      <div class:list={['relative w-[34%] overflow-hidden rounded-[14px] p-[5%]', win]}>
        <div class="flex flex-col gap-2">
          <span class="h-2 w-2/3 rounded-full bg-ink"></span>
          <span class="h-12 rounded-[8px] bg-accent-soft"></span>
          <span class="h-1.5 w-full rounded-full bg-ink/10"></span>
          <span class="h-1.5 w-3/4 rounded-full bg-ink/10"></span>
          <span class="h-8 rounded-[8px] bg-paper"></span>
          <span class="h-1.5 w-2/3 rounded-full bg-ink/10"></span>
        </div>
        <span class="sd-scan pointer-events-none absolute inset-x-0 h-10 bg-gradient-to-b from-transparent to-accent/25">
          <span class="absolute inset-x-0 bottom-0 h-0.5 bg-accent"></span>
        </span>
      </div>
      <div class:list={['flex flex-1 flex-col justify-center gap-[7%] rounded-[14px] px-[4%] text-ink', win]}>
        <div class="flex justify-around">
          {rings.map((r, n) => (
            <div class="flex flex-col items-center gap-1">
              <div class="relative size-[clamp(48px,6vw,76px)]">
                <svg viewBox="0 0 36 36" class="size-full -rotate-90">
                  <circle cx="18" cy="18" r="15.5" fill="none" stroke="#0d0d0d" stroke-opacity=".08" stroke-width="3.5" />
                  <circle class="sd-ring" cx="18" cy="18" r="15.5" fill="none" stroke={r.c} stroke-width="3.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" style={`--v: ${100 - r.v}; --d: ${n * 0.3}s`} />
                </svg>
                <span class="sd-pop absolute inset-0 flex items-center justify-center text-[clamp(12px,1.2vw,16px)] font-semibold tracking-[-0.03em]" style={`--d: ${1.2 + n * 0.3}s`}>{r.v}</span>
              </div>
              <span class="text-[10px] text-ink/50">{c.audit.rings[n]}</span>
            </div>
          ))}
        </div>
        <div class="flex flex-col gap-1.5 px-[4%]">
          {c.audit.checks.map((label, n) => (
            <div class="sd-pop flex items-center gap-2 text-[11px]" style={`--d: ${2 + n * 0.35}s`}>
              <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-success text-white"><Fragment set:html={check} /></span>
              {label}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</div>
