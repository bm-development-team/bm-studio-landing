---
/**
 * Tiny animated illustration for a service card.
 * Static "before" state by default; plays when an ancestor gets .sd-play (its field scrolls into view).
 * Order matches services.items: 0 UX/UI, 1 web development, 2 landing pages, 3 redesign.
 */
interface Props {
  variant: number;
}
const { variant } = Astro.props;
---

<div data-ui class="sd relative h-[150px] w-full overflow-hidden bg-white sm:h-[180px] lg:h-[210px]" aria-hidden="true">
  {variant === 0 && (
    <div class="sd-ux absolute inset-3 flex flex-col gap-2">
      <span class="sd-ux-bar h-2.5 w-1/3 rounded-full"></span>
      <div class="flex flex-1 gap-2">
        <span class="sd-ux-img flex-1 rounded-[8px]"></span>
        <div class="flex flex-1 flex-col justify-center gap-1.5">
          <span class="sd-ux-line h-2 w-full rounded-full"></span>
          <span class="sd-ux-line h-2 w-3/4 rounded-full"></span>
          <span class="sd-ux-btn mt-1 h-4 w-1/2 rounded-full"></span>
        </div>
      </div>
      <span class="sd-ux-cursor absolute size-3 rounded-full border-2 border-white bg-ink"></span>
    </div>
  )}

  {variant === 1 && (
    <div class="absolute inset-0 flex flex-col">
      <div class="flex gap-1 border-b border-[#e6e6e6] px-3 py-2">
        <span class="size-1.5 rounded-full bg-[#ff5f57]"></span>
        <span class="size-1.5 rounded-full bg-[#febc2e]"></span>
        <span class="size-1.5 rounded-full bg-[#28c840]"></span>
      </div>
      <div class="grid flex-1 grid-cols-2 gap-3 p-3">
        <div class="flex flex-col gap-1.5">
          <span class="sd-code h-1.5 rounded-full bg-[#c792ea]" style="--w: 70%; --d: 0ms"></span>
          <span class="sd-code ml-2 h-1.5 rounded-full bg-[#82aaff]" style="--w: 55%; --d: 150ms"></span>
          <span class="sd-code ml-2 h-1.5 rounded-full bg-blue" style="--w: 80%; --d: 300ms"></span>
          <span class="sd-code ml-4 h-1.5 rounded-full bg-[#c3e88d]" style="--w: 45%; --d: 450ms"></span>
          <span class="sd-code ml-2 h-1.5 rounded-full bg-[#82aaff]" style="--w: 60%; --d: 600ms"></span>
          <span class="sd-code h-1.5 rounded-full bg-[#c792ea]" style="--w: 35%; --d: 750ms"></span>
        </div>
        <div class="sd-preview flex flex-col gap-1.5 bg-[#f6f6f6] p-2">
          <span class="bg-red h-6 rounded-[4px]"></span>
          <span class="h-1.5 w-3/4 rounded-full bg-[#e5e5e5]"></span>
          <span class="h-1.5 w-1/2 rounded-full bg-[#e5e5e5]"></span>
        </div>
      </div>
    </div>
  )}

  {variant === 2 && (
    <div class="absolute inset-x-6 inset-y-2 overflow-hidden border border-[#e6e6e6] bg-white">
      <div class="sd-scroll flex flex-col gap-2 p-2">
        <span class="bg-red h-14 shrink-0 rounded-[5px]"></span>
        <span class="mx-auto h-1.5 w-2/3 shrink-0 rounded-full bg-[#e5e5e5]"></span>
        <div class="grid shrink-0 grid-cols-3 gap-1.5">
          <span class="h-8 rounded-[4px] bg-[#f1f1f1]"></span>
          <span class="h-8 rounded-[4px] bg-[#f1f1f1]"></span>
          <span class="h-8 rounded-[4px] bg-[#f1f1f1]"></span>
        </div>
        <span class="h-10 shrink-0 rounded-[5px] bg-[#111]"></span>
        <span class="mx-auto h-4 w-1/3 shrink-0 rounded-full bg-blue"></span>
        <span class="bg-red h-14 shrink-0 rounded-[5px]"></span>
        <span class="mx-auto h-1.5 w-2/3 shrink-0 rounded-full bg-[#e5e5e5]"></span>
      </div>
    </div>
  )}

  {variant === 3 && (
    <div class="absolute inset-0">
      <!-- old -->
      <div class="absolute inset-0 flex flex-col gap-1.5 bg-[#f4f4e6] p-3 font-serif">
        <span class="text-[13px] font-bold text-[#0000ee] underline">Welcome!!!</span>
        <div class="flex gap-1.5">
          <span class="h-9 w-12 border border-[#999] bg-[#ccc]"></span>
          <div class="flex flex-1 flex-col gap-1">
            <span class="h-1.5 w-full bg-[#aaa]"></span>
            <span class="h-1.5 w-full bg-[#aaa]"></span>
            <span class="h-1.5 w-2/3 bg-[#aaa]"></span>
          </div>
        </div>
        <span class="w-fit border border-[#666] bg-[#ddd] px-1 text-[9px] text-black">click here</span>
      </div>
      <!-- new (wipes in) -->
      <div class="sd-new absolute inset-0 flex flex-col justify-center gap-2 bg-white p-3">
        <span class="h-2.5 w-1/2 rounded-full bg-ink"></span>
        <span class="h-1.5 w-3/4 rounded-full bg-[#e5e5e5]"></span>
        <span class="bg-red h-5 w-1/3 rounded-full"></span>
      </div>
      <span class="sd-handle absolute inset-y-0 w-0.5 bg-blue"></span>
    </div>
  )}
</div>
