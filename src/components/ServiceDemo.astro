---
/**
 * Looping animated illustration for a service card (slow, ~8s cycles).
 * Base styles are the finished picture (what reduced-motion users see);
 * the loops run only while an ancestor has .sd-play (card on screen).
 * Order matches services.items: 0 UX/UI, 1 web development, 2 landing pages, 3 redesign, 4 SEO, 5 GEO, 6 audit.
 */
interface Props {
  variant: number;
}
const { variant } = Astro.props;

const code = [
  { w: 62, c: '#7c87ff', i: 0 },
  { w: 48, c: '#c9cdff', i: 1 },
  { w: 70, c: '#2033f7', i: 1 },
  { w: 40, c: '#9ee6b8', i: 2 },
  { w: 56, c: '#c9cdff', i: 1 },
  { w: 30, c: '#7c87ff', i: 0 },
];
// SEO: our result (row 3) climbs to the top, the others step down one place
const results = [
  { from: 0, to: 1, ours: false },
  { from: 1, to: 2, ours: false },
  { from: 2, to: 3, ours: false },
  { from: 3, to: 0, ours: true },
];
// audit: score rings (value out of 100)
const rings = [
  { v: 98, c: '#2033f7' },
  { v: 92, c: '#0b0b14' },
  { v: 95, c: '#1fbf6b' },
];
const search = `<svg viewBox="0 0 24 24" class="size-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4-4"/></svg>`;
const spark = `<svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>`;
const cursor = `<svg viewBox="0 0 24 24" class="size-full drop-shadow-[0_2px_3px_rgba(0,0,0,0.25)]"><path d="M4 2l15 9-6.5 1.5L10 19z" fill="#0b0b14" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>`;
---

<div data-ui class="sd relative h-[190px] w-full overflow-hidden rounded-[18px] bg-paper sm:h-[220px] lg:h-[260px]" aria-hidden="true">
  {variant === 0 && (
    <div class="absolute inset-[8%] flex flex-col gap-[6%] rounded-[16px] bg-white p-[5%] shadow-[0_20px_40px_-24px_rgba(11,11,20,0.25)]">
      <div class="flex items-center gap-2">
        <span class="sd-wire h-3 w-[30%] rounded-full" style="--c: #0b0b14; --d: 0s"></span>
        <span class="ml-auto sd-wire size-3 rounded-full" style="--c: #c9cdff; --d: .15s"></span>
      </div>
      <div class="flex flex-1 gap-[5%]">
        <span class="sd-wire flex-1 rounded-[12px]" style="--c: #2033f7; --d: .3s"></span>
        <div class="flex flex-1 flex-col justify-center gap-2.5">
          <span class="sd-wire h-2.5 w-full rounded-full" style="--c: #d9dbe6; --d: .45s"></span>
          <span class="sd-wire h-2.5 w-3/4 rounded-full" style="--c: #d9dbe6; --d: .6s"></span>
          <span class="sd-wire sd-ux-btn relative mt-2 h-7 w-[62%] rounded-full" style="--c: #2033f7; --d: .75s">
            <span class="sd-ripple absolute inset-0 rounded-full border-2 border-blue"></span>
          </span>
        </div>
      </div>
      <span class="sd-ux-cursor absolute size-6" set:html={cursor}></span>
    </div>
  )}

  {variant === 1 && (
    <div class="absolute inset-[7%] flex gap-[4%]">
      <div class="flex flex-1 flex-col gap-2 rounded-[14px] bg-ink p-[6%] pt-[8%]">
        {code.map((l, n) => (
          <span class="sd-code h-2 rounded-full" style={`--w: ${l.w}%; --d: ${n * 0.35}s; background: ${l.c}; margin-left: ${l.i * 10}px`}></span>
        ))}
        <span class="sd-caret mt-1 h-3 w-1 rounded-full bg-white/70"></span>
      </div>
      <div class="relative flex flex-1 flex-col gap-[7%] rounded-[14px] bg-white p-[6%]">
        <span class="sd-pop h-2.5 w-1/2 rounded-full bg-ink" style="--d: .6s"></span>
        <span class="sd-pop h-[38%] rounded-[10px] bg-blue" style="--d: 1.1s"></span>
        <div class="grid flex-1 grid-cols-3 gap-[6%]">
          <span class="sd-pop rounded-[8px] bg-paper" style="--d: 1.5s"></span>
          <span class="sd-pop rounded-[8px] bg-paper" style="--d: 1.7s"></span>
          <span class="sd-pop rounded-[8px] bg-paper" style="--d: 1.9s"></span>
        </div>
        <span class="sd-live absolute -right-2 -top-3 flex size-8 items-center justify-center rounded-full bg-[#1fbf6b] text-white shadow-lg">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </span>
      </div>
    </div>
  )}

  {variant === 2 && (
    <div class="absolute inset-x-[14%] top-[8%] bottom-0 overflow-hidden rounded-t-[16px] bg-white shadow-[0_20px_40px_-24px_rgba(11,11,20,0.25)]">
      <div class="flex h-6 items-center gap-1 border-b border-ink/5 px-3">
        <span class="size-1.5 rounded-full bg-ink/15"></span><span class="size-1.5 rounded-full bg-ink/15"></span><span class="size-1.5 rounded-full bg-ink/15"></span>
      </div>
      <div class="sd-scroll flex flex-col gap-3 p-4">
        <span class="mx-auto h-3 w-2/3 rounded-full bg-ink"></span>
        <span class="mx-auto h-2 w-1/2 rounded-full bg-ink/10"></span>
        <span class="h-24 shrink-0 rounded-[12px] bg-blue"></span>
        <div class="grid shrink-0 grid-cols-3 gap-2">
          <span class="h-14 rounded-[10px] bg-paper"></span><span class="h-14 rounded-[10px] bg-paper"></span><span class="h-14 rounded-[10px] bg-paper"></span>
        </div>
        <span class="h-2 w-3/4 rounded-full bg-ink/10"></span>
        <span class="h-2 w-1/2 rounded-full bg-ink/10"></span>
        <span class="h-20 shrink-0 rounded-[12px] bg-ink"></span>
        <span class="sd-cta mx-auto h-8 w-1/2 shrink-0 rounded-full bg-blue"></span>
      </div>
      <span class="sd-toast absolute right-3 top-9 flex items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-[11px] font-medium text-white shadow-lg">
        <span class="size-1.5 rounded-full bg-[#1fbf6b]"></span>+1
      </span>
    </div>
  )}

  {variant === 3 && (
    <div class="absolute inset-[7%] overflow-hidden rounded-[14px]">
      <!-- old -->
      <div class="absolute inset-0 flex flex-col gap-2 bg-[#efe9d6] p-[6%] font-serif">
        <span class="text-[15px] font-bold text-[#1a0dab] underline">Welcome!!!</span>
        <div class="flex gap-2">
          <span class="h-12 w-16 border border-[#999] bg-[#cfc8b4]"></span>
          <div class="flex flex-1 flex-col gap-1.5">
            <span class="h-1.5 w-full bg-[#aaa]"></span><span class="h-1.5 w-full bg-[#aaa]"></span><span class="h-1.5 w-2/3 bg-[#aaa]"></span>
          </div>
        </div>
        <span class="w-fit border border-[#666] bg-[#ddd] px-1.5 text-[10px] text-black">click here</span>
      </div>
      <!-- new -->
      <div class="sd-new absolute inset-0 flex items-center gap-[6%] bg-white p-[6%]">
        <div class="flex flex-1 flex-col gap-2.5">
          <span class="h-3.5 w-full rounded-full bg-ink"></span>
          <span class="h-3.5 w-2/3 rounded-full bg-ink"></span>
          <span class="h-2 w-3/4 rounded-full bg-ink/10"></span>
          <span class="mt-1 h-7 w-1/2 rounded-full bg-blue"></span>
        </div>
        <span class="aspect-square w-[34%] rounded-full bg-blue-soft"></span>
      </div>
      <span class="sd-handle absolute inset-y-0 w-0.5 -translate-x-1/2 bg-blue">
        <span class="absolute left-1/2 top-1/2 flex size-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-blue text-[11px] font-bold text-white shadow-lg">‹›</span>
      </span>
    </div>
  )}
  {variant === 4 && (
    <div class="absolute inset-[7%] flex flex-col gap-[5%] rounded-[16px] bg-white p-[5%] shadow-[0_20px_40px_-24px_rgba(11,11,20,0.25)]">
      <div class="flex h-8 shrink-0 items-center gap-2 rounded-full bg-paper px-3 text-ink/50">
        <Fragment set:html={search} />
        <span class="sd-code h-2 rounded-full bg-ink/60" style="--w: 45%; --d: 0s"></span>
        <span class="sd-caret h-3 w-0.5 rounded-full bg-ink/50"></span>
      </div>
      <div class="relative flex-1">
        {results.map((r) => (
          <div
            class:list={['sd-rank absolute inset-x-0 flex h-[21%] items-center gap-3 rounded-[10px] px-3', r.ours ? 'z-10 bg-blue text-white shadow-[0_10px_24px_-10px_rgba(32,51,247,0.7)]' : 'bg-paper']}
            style={`--a: ${r.from * 26}%; --b: ${r.to * 26}%`}
          >
            <span class:list={['h-2 w-[34%] rounded-full', r.ours ? 'bg-white' : 'bg-ink/25']}></span>
            <span class:list={['h-1.5 w-[22%] rounded-full', r.ours ? 'bg-white/50' : 'bg-ink/10']}></span>
            {r.ours && <span class="sd-up ml-auto text-[11px] font-semibold">▲ 1</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  {variant === 5 && (
    <div class="absolute inset-[7%] flex flex-col gap-[6%] rounded-[16px] bg-white p-[5%] shadow-[0_20px_40px_-24px_rgba(11,11,20,0.25)]">
      <div class="sd-pop ml-auto flex w-[56%] flex-col gap-1.5 rounded-[14px] rounded-br-[4px] bg-paper px-3 py-2.5" style="--d: 0s">
        <span class="h-1.5 w-full rounded-full bg-ink/40"></span>
        <span class="h-1.5 w-2/3 rounded-full bg-ink/40"></span>
      </div>
      <div class="flex gap-2.5">
        <span class="sd-pop flex size-7 shrink-0 items-center justify-center rounded-full bg-ink text-white" style="--d: .8s"><Fragment set:html={spark} /></span>
        <div class="flex flex-1 flex-col gap-2 pt-1.5">
          <span class="sd-code h-1.5 rounded-full bg-ink/25" style="--w: 92%; --d: 1.1s"></span>
          <span class="sd-code h-1.5 rounded-full bg-ink/25" style="--w: 80%; --d: 1.5s"></span>
          <span class="sd-code h-1.5 rounded-full bg-blue" style="--w: 64%; --d: 1.9s"></span>
          <span class="sd-code h-1.5 rounded-full bg-ink/25" style="--w: 72%; --d: 2.3s"></span>
          <div class="sd-pop mt-1.5 flex w-fit items-center gap-2 rounded-full bg-blue py-1.5 pl-1.5 pr-3 text-white shadow-[0_10px_24px_-10px_rgba(32,51,247,0.7)]" style="--d: 3s">
            <span class="size-4 rounded-full bg-white"></span>
            <span class="h-1.5 w-12 rounded-full bg-white/80"></span>
            <span class="text-[10px] font-semibold">↗</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {variant === 6 && (
    <div class="absolute inset-[7%] flex gap-[5%]">
      <div class="relative w-[38%] overflow-hidden rounded-[14px] bg-white p-[5%] shadow-[0_20px_40px_-24px_rgba(11,11,20,0.25)]">
        <div class="flex flex-col gap-2">
          <span class="h-2 w-2/3 rounded-full bg-ink"></span>
          <span class="h-12 rounded-[8px] bg-blue-soft"></span>
          <span class="h-1.5 w-full rounded-full bg-ink/10"></span>
          <span class="h-1.5 w-3/4 rounded-full bg-ink/10"></span>
          <span class="h-8 rounded-[8px] bg-paper"></span>
          <span class="h-1.5 w-2/3 rounded-full bg-ink/10"></span>
        </div>
        <span class="sd-scan pointer-events-none absolute inset-x-0 h-10 bg-gradient-to-b from-transparent to-blue/25">
          <span class="absolute inset-x-0 bottom-0 h-0.5 bg-blue"></span>
        </span>
      </div>
      <div class="flex flex-1 flex-col justify-center gap-[8%]">
        <div class="flex justify-around">
          {rings.map((r, n) => (
            <div class="relative size-[clamp(52px,7vw,84px)]">
              <svg viewBox="0 0 36 36" class="size-full -rotate-90">
                <circle cx="18" cy="18" r="15.5" fill="none" stroke="#0b0b14" stroke-opacity=".08" stroke-width="3.5" />
                <circle class="sd-ring" cx="18" cy="18" r="15.5" fill="none" stroke={r.c} stroke-width="3.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" style={`--v: ${100 - r.v}; --d: ${n * 0.3}s`} />
              </svg>
              <span class="sd-pop absolute inset-0 flex items-center justify-center text-[clamp(12px,1.3vw,17px)] font-semibold tracking-[-0.03em] text-ink" style={`--d: ${1.2 + n * 0.3}s`}>{r.v}</span>
            </div>
          ))}
        </div>
        <div class="flex flex-col gap-2 px-[6%]">
          {[0, 1, 2].map((n) => (
            <div class="sd-pop flex items-center gap-2" style={`--d: ${2 + n * 0.35}s`}>
              <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-[#1fbf6b] text-white">
                <svg viewBox="0 0 24 24" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              </span>
              <span class="h-1.5 rounded-full bg-ink/15" style={`width: ${[70, 55, 62][n]}%`}></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</div>
